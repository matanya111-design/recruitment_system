# Database
DATABASE_URL=postgresql://app:change-me@localhost:5432/candidate_manager

# Session secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string

# Application
APP_OWNER_EMAIL=owner@example.com
APP_BASE_URL=http://localhost:3000

# AI provider switch: "openai" (default, CodeMie proxy or native OpenAI) or "anthropic" (direct Anthropic account, no CodeMie)
AI_PROVIDER=openai

# OpenAI / CodeMie proxy (used when AI_PROVIDER is unset or "openai")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Anthropic direct (used only when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=candidate-cv
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true
